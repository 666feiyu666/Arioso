{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Arioso Current Workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/arioso-current-workflow.html"
  },
  "lanes": [
    { "id": "flow", "label": "Arioso Workflow" }
  ],
  "phases": [
    { "id": "intake", "label": "Intake + discuss", "fromCol": 0, "toCol": 2, "variant": "emphasis" },
    { "id": "compose", "label": "Compose + deliver", "fromCol": 3, "toCol": 3, "variant": "emphasis" }
  ],
  "groups": [
    { "id": "discussion_loop", "label": "Conversation + proposal", "lane": "flow", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "composition_modes", "label": "Composition modes", "lane": "flow", "fromCol": 3, "toCol": 3, "variant": "dashed" }
  ],
  "mainPath": [
    "task_request",
    "discussion_session",
    "workflow_router",
    "composition_agents",
    "lyria_generation",
    "saved_results"
  ],
  "semanticChecks": {
    "allowedRoots": ["task_request"],
    "allowedTerminals": ["saved_results", "album_producer"],
    "requiredPaths": [
      { "from": "task_request", "to": "saved_results" },
      { "from": "task_request", "to": "album_producer" }
    ]
  },
  "nodes": [
    { "id": "task_request", "lane": "flow", "col": 0, "type": "frontend", "label": "Music Brief & Settings", "width": 168 },
    { "id": "discussion_session", "lane": "flow", "col": 1, "type": "backend", "label": "Creative Discussion", "sublabel": "Prompt Director", "width": 168 },
    { "id": "workflow_router", "lane": "flow", "col": 2, "type": "backend", "label": "Workflow Router", "sublabel": "approved prompt or direct task", "width": 168 },
    { "id": "composition_agents", "lane": "flow", "col": 3, "type": "backend", "label": "Composition Agents", "sublabel": "general/Jazz · orchestral · album", "width": 180 },
    { "id": "lyria_generation", "lane": "flow", "col": 3, "type": "cloud", "label": "Google Lyria", "width": 150, "yOffset": 80 },
    { "id": "saved_results", "lane": "flow", "col": 3, "type": "database", "label": "Saved Results", "sublabel": "audio, plans, and task records", "width": 164, "yOffset": 160 },
    { "id": "album_producer", "lane": "flow", "col": 3, "type": "backend", "label": "Album Producer", "sublabel": "denoise · assemble · export", "width": 160, "yOffset": 240 }
  ],
  "edges": [
    { "id": "create_task", "from": "task_request", "to": "discussion_session", "label": "start discussion", "variant": "emphasis", "role": "main" },
    { "id": "approved_prompt", "from": "discussion_session", "to": "workflow_router", "label": "approved proposal", "variant": "emphasis", "role": "main" },
    { "id": "direct_task", "from": "task_request", "to": "workflow_router", "label": "direct task API", "variant": "dashed", "role": "branch", "route": "up-channel" },
    { "id": "choose_composition", "from": "workflow_router", "to": "composition_agents", "label": "mode", "variant": "emphasis", "role": "main" },
    { "id": "generate_composition", "from": "composition_agents", "to": "lyria_generation", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "persist_results", "from": "lyria_generation", "to": "saved_results", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "postproduce_album", "from": "saved_results", "to": "album_producer", "variant": "dashed", "role": "branch", "fromSide": "bottom", "toSide": "top", "route": "straight" }
  ]
}
